---
import { Icon } from "astro-icon/components";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const processedLinks = Astro.props.links;

function isCurrent(link: NavBarLink): boolean {
	const normalized = link.url.replace(/\/$/, "") || "/";
	return (
		!link.external &&
		(normalized === "/"
			? Astro.url.pathname === "/"
			: Astro.url.pathname === normalized ||
				Astro.url.pathname.startsWith(`${normalized}/`))
	);
}
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed transition-all fixed right-4 px-2 py-2 max-h-[80vh] overflow-y-auto"]}>
    {processedLinks.map((link) => (
        <div class="mobile-menu-item">
            {link.children && link.children.length > 0 ? (
                /* 有子菜单的项目 */
                <div class="mobile-dropdown" data-mobile-dropdown>
                    <button
                        class="group flex justify-between items-center py-2 pl-3 pr-1 rounded-lg gap-8 w-full text-left
                            hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active) transition"
                        data-mobile-dropdown-trigger
                        aria-expanded="false"
                    >
                        <div class="flex items-center transition text-black/75 dark:text-white/75 font-bold group-hover:text-(--primary) group-active:text-(--primary)">
							{link.icon && <Icon is:inline name={link.icon} class="text-[1.1rem] mr-2" />}
                            {link.name}
                        </div>
                        <Icon is:inline name="material-symbols:keyboard-arrow-down-rounded"
                              class="transition text-[1.25rem] text-(--primary) mobile-dropdown-arrow duration-200"
                        />
                    </button>
                    <div class="mobile-submenu" data-mobile-submenu>
                        {link.children.map((child) => (
                            <a href={child.external ? child.url : url(child.url)}
                               class="group flex justify-between items-center py-2 pl-6 pr-1 rounded-lg gap-8
                                   hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active) transition"
                               target={child.external ? "_blank" : null}
                            >
                                <div class="flex items-center transition text-black/60 dark:text-white/60 font-medium group-hover:text-(--primary) group-active:text-(--primary)">
									{child.icon && <Icon is:inline name={child.icon} class="text-[1.1rem] mr-2" />}
                                    {child.name}
                                </div>
                                {child.external && <Icon is:inline name="fa7-solid:arrow-up-right-from-square"
                                      class="transition text-[0.75rem] text-black/25 dark:text-white/25 -translate-x-1"
                                />}
                            </a>
                        ))}
                    </div>
                </div>
            ) : (
                /* 普通链接项目 */
				<a
					href={link.external ? link.url : url(link.url)}
					class:list={[
						"group flex justify-between items-center py-2 pl-3 pr-1 rounded-lg gap-8 hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active) transition",
						link.highlight && `mobile-link-highlight mobile-link-highlight-${link.highlightVariant ?? "default"}`,
						 isCurrent(link) && "mobile-link-current",
					]}
                   target={link.external ? "_blank" : null}
                >
					<div class:list={[
						"flex items-center transition text-black/75 dark:text-white/75 font-bold group-hover:text-(--primary) group-active:text-(--primary)",
						link.highlight && "highlight-label",
					]}>
						{link.icon && <Icon is:inline name={link.icon} class="text-[1.1rem] mr-2" />}
                        {link.name}
                    </div>
					{!link.external && <Icon is:inline name="material-symbols:chevron-right-rounded"
                          class="transition text-[1.25rem] text-(--primary)"
                    />}
					{link.external && <Icon is:inline name="fa7-solid:arrow-up-right-from-square"
                          class="transition text-[0.75rem] text-black/25 dark:text-white/25 -translate-x-1"
                    />}
                </a>
            )}
        </div>
    ))}
</div>

<style>
    @reference "../../styles/main.css";

    .mobile-submenu {
        @apply max-h-0 overflow-hidden transition-all duration-300 ease-in-out;
    }

    .mobile-dropdown[data-expanded="true"] .mobile-submenu {
        @apply max-h-96;
    }

    .mobile-dropdown[data-expanded="true"] .mobile-dropdown-arrow {
        @apply rotate-180;
    }

	.mobile-link-highlight {
		color: #422006;
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--primary) 48%, #fbbf24),
			#fb923c
		);
		box-shadow: 0 8px 20px rgb(245 158 11 / 0.18);
	}

	.mobile-link-highlight .highlight-label,
	.mobile-link-highlight:hover .highlight-label,
	.mobile-link-highlight:active .highlight-label {
		color: inherit;
	}

	.mobile-link-highlight:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	:global(.dark) .mobile-link-highlight {
		color: #fff7ed;
	}	.mobile-link-highlight-career {
		color: #fff;
		background: linear-gradient(135deg, #4f46e5, #7c3aed 58%, #a855f7);
		box-shadow: 0 8px 20px rgb(99 102 241 / 0.2);
	}

	.mobile-link-highlight-career:hover,
	.mobile-link-highlight-career:active {
		color: #fff;
		filter: saturate(1.08) brightness(1.05);
	}

	.mobile-link-highlight-career:focus-visible,
	.mobile-link-current {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	:global(.dark) .mobile-link-highlight-career {
		color: #fff;
		background: linear-gradient(135deg, #6366f1, #8b5cf6 58%, #c084fc);
	}
	.mobile-link-highlight-career {
		color: #fff;
		background: linear-gradient(135deg, #4f46e5, #7c3aed 58%, #a855f7);
		box-shadow: 0 8px 20px rgb(99 102 241 / 0.2);
	}

	.mobile-link-highlight-career:hover,
	.mobile-link-highlight-career:active {
		color: #fff;
		filter: saturate(1.08) brightness(1.05);
	}

	.mobile-link-highlight-career:focus-visible,
	.mobile-link-current {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	:global(.dark) .mobile-link-highlight-career {
		color: #fff;
		background: linear-gradient(135deg, #6366f1, #8b5cf6 58%, #c084fc);
	}
