---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { shopConfig } from "@/config/shopConfig";
import { formatShopCurrency, formatShopPrice } from "@/utils/shop-utils";
import { url } from "@/utils/url-utils";
import ShopStatusBadge from "./ShopStatusBadge.astro";

interface Props {
	product: CollectionEntry<"products">;
	compact?: boolean;
}

const { product, compact = false } = Astro.props;
const data = product.data;
const category = shopConfig.categories.find(
	(item) => item.id === data.category,
);

const conditionLabel = data.condition
	? data.condition
			.split("-")
			.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
			.join(" ")
	: null;
---

<article
	class:list={[
		"shop-product-card card-base group overflow-hidden border border-black/5 dark:border-white/8",
		compact ? "grid grid-cols-[6.5rem_1fr] sm:grid-cols-[8rem_1fr]" : "flex flex-col",
	]}
>
	<a
		href={url(`/shop/${data.slug}/`)}
		class:list={[
			"relative block overflow-hidden bg-black/3 dark:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-(--primary)",
			compact ? "min-h-32" : "aspect-[4/3]",
		]}
		aria-label={`View ${data.title}`}
	>
		{data.image ? (
			<img
				src={url(data.image)}
				alt={data.imageAlt || data.title}
				loading="lazy"
				class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.025]"
			/>
		) : (
			<div class="shop-placeholder absolute inset-0 flex flex-col items-center justify-center gap-2 text-center text-black/45 dark:text-white/45">
				<Icon is:inline name={category?.icon || "material-symbols:inventory-2"} class="text-4xl" />
				<span class="text-xs font-bold uppercase tracking-[0.14em]">Image coming soon</span>
			</div>
		)}
	</a>

	<div class:list={["flex min-w-0 flex-1 flex-col", compact ? "p-4" : "p-5"]}>
		<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
			<span class="text-xs font-bold uppercase tracking-[0.14em] text-(--primary)">
				{category?.label || data.category}
			</span>
			<ShopStatusBadge status={data.status} />
		</div>

		<h3 class:list={["font-bold text-black/90 dark:text-white/90", compact ? "text-base" : "text-xl"]}>
			<a href={url(`/shop/${data.slug}/`)} class="rounded hover:text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--primary)">
				{data.title}
			</a>
		</h3>

		{data.description && (
			<p class:list={["mt-2 text-black/60 dark:text-white/60", compact ? "line-clamp-2 text-sm" : "line-clamp-3"]}>
				{data.description}
			</p>
		)}

		<div class="mt-auto flex flex-wrap items-end justify-between gap-3 pt-5">
			<div>
				<div class="flex flex-wrap items-baseline gap-2">
					<span class="text-lg font-extrabold text-black/85 dark:text-white/90">{formatShopPrice(data)}</span>
					{typeof data.price === "number" && typeof data.compareAtPrice === "number" && data.compareAtPrice > data.price && (
						<span class="text-sm text-black/35 line-through dark:text-white/35">{formatShopCurrency(data.compareAtPrice, data.currency)}</span>
					)}
				</div>
				{conditionLabel && <div class="mt-1 text-xs text-black/45 dark:text-white/45">Condition: {conditionLabel}</div>}
			</div>

			<a
				href={url(`/shop/${data.slug}/`)}
				class="inline-flex items-center gap-1 rounded-lg bg-black/5 px-3 py-2 text-sm font-bold text-black/70 transition hover:bg-(--primary) hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--primary) dark:bg-white/8 dark:text-white/75"
			>
				View item
				<Icon is:inline name="material-symbols:arrow-forward-rounded" />
			</a>
		</div>
	</div>
</article>

<style>
	.shop-placeholder {
		background:
			radial-gradient(circle at 75% 20%, rgb(251 191 36 / 0.24), transparent 38%),
			linear-gradient(135deg, color-mix(in srgb, var(--primary) 12%, transparent), transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		.shop-product-card img,
		.shop-product-card a {
			transition: none;
		}
	}
</style>
