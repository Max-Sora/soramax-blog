---
import type { ShopProductStatus } from "@/types/shopConfig";

interface Props {
	status: ShopProductStatus;
}

const { status } = Astro.props;

const statusLabels: Record<ShopProductStatus, string> = {
	"in-stock": "In Stock",
	"low-stock": "Low Stock",
	"sold-out": "Sold Out",
	"coming-soon": "Coming Soon",
};

const statusStyles: Record<ShopProductStatus, string> = {
	"in-stock":
		"bg-emerald-100 text-emerald-800 border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-200 dark:border-emerald-800",
	"low-stock":
		"bg-amber-100 text-amber-900 border-amber-200 dark:bg-amber-950/60 dark:text-amber-200 dark:border-amber-800",
	"sold-out":
		"bg-neutral-200 text-neutral-700 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-300 dark:border-neutral-700",
	"coming-soon":
		"bg-sky-100 text-sky-800 border-sky-200 dark:bg-sky-950/60 dark:text-sky-200 dark:border-sky-800",
};
---

<span
	class:list={[
		"inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-bold tracking-wide",
		statusStyles[status],
	]}
>
	{statusLabels[status]}
</span>
