---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="Projects" description="Hardware, server, and software engineering projects.">
	<div class="card-base p-8">
		<p class="text-lg">A compact list of my side projects and experiments in hardware and software.</p>
		<ul class="mt-6 list-disc pl-6 space-y-2">
			<li>PC builds and BIOS/firmware tuning notes</li>
			<li>Home server deployment and networking notes</li>
			<li>Embedded systems prototypes and demos</li>
		</ul>
	</div>
	<a href="/tools/career-navigator/" class="card-base mt-6 block p-8 transition hover:-translate-y-1">
		<div class="flex items-start justify-between gap-4">
			<div>
				<p class="text-xs font-bold tracking-[0.16em] text-[var(--primary)]">SORAMAX TOOL · LOCAL-FIRST</p>
				<h2 class="mt-2 text-2xl font-semibold">Career Navigator</h2>
				<p class="mt-3 max-w-2xl text-[var(--content-meta)]">Work backwards from a target role to evidence, a time-bounded roadmap, and manual application tracking. Sample data is labeled and personal data stays local by default.</p>
			</div>
			<span class="text-xl text-[var(--primary)]">↗</span>
		</div>
	</a>
</MainGridLayout>
