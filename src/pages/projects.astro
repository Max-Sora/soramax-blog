---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const projects = [
	{
		name: "Career Navigator",
		status: "Live tool",
		description:
			"Reverse-plan a target role into evidence, an editable roadmap, and manual application tracking.",
		href: "/tools/career-navigator/",
		label: "Open tool",
	},
	{
		name: "EE Intelligence",
		status: "Live public demo",
		description:
			"Explore provenance-aware event intelligence, engineering cases, hardware diagnosis, and leakage-safe signal experiments.",
		href: "/tools/ee-intelligence/",
		label: "Open tool",
	},
	{
		name: "Hardware and PC Builds",
		status: "Ongoing notes",
		description:
			"PC building, firmware tuning, troubleshooting, and practical hardware experiments documented as posts.",
		href: "/posts/?tag=Hardware",
		label: "Browse posts",
	},
	{
		name: "Servers and Networking",
		status: "Ongoing notes",
		description:
			"Home server deployment, Linux services, networking, and self-hosting experiments.",
		href: "/posts/?tag=Servers",
		label: "Browse posts",
	},
	{
		name: "Embedded Prototypes",
		status: "Ongoing notes",
		description:
			"Arduino, ESP32, embedded systems, and small hardware prototypes built while learning by iteration.",
		href: "/posts/?tag=Embedded%20Systems",
		label: "Browse posts",
	},
];
---

<MainGridLayout title="Projects" description="Hardware, server, software, and public engineering tools.">
	<div class="card-base p-8">
		<p class="text-lg">A single entry point for the tools, experiments, and engineering notes I am actively building.</p>
	</div>
	<div class="mt-6 grid gap-4 md:grid-cols-2">
		{projects.map((project) => (
			<a href={project.href} class="card-base group block p-6 transition hover:-translate-y-1">
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="text-xs font-bold tracking-[0.16em] text-[var(--primary)]">{project.status}</p>
						<h2 class="mt-2 text-xl font-semibold">{project.name}</h2>
						<p class="mt-3 text-[var(--content-meta)]">{project.description}</p>
						<span class="mt-5 inline-block text-sm font-semibold text-[var(--primary)]">{project.label}</span>
					</div>
					<span class="text-xl text-[var(--primary)] transition group-hover:translate-x-1">-&gt;</span>
				</div>
			</a>
		))}
	</div>
</MainGridLayout>